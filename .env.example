# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (used by the postgres container; the app URLs are composed in docker-compose.yml)
POSTGRES_USER=icm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=icm

# --- Application
ICM_ENVIRONMENT=production
ICM_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ICM_SECRET_KEY=change-me-generate-a-long-random-string
# Comma-separated Host header allowlist. Production refuses to boot with "*".
# Keep 127.0.0.1 in the list: the api container's Docker healthcheck uses it.
ICM_ALLOWED_HOSTS=your.real.domain,127.0.0.1

# --- Edge proxy: set to your real domain for automatic HTTPS via Let's Encrypt.
# Leave as localhost for local testing (Caddy issues an internal certificate).
DOMAIN=localhost
