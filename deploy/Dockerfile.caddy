# Edge image: builds the operations console and serves it from Caddy,
# which also proxies API paths to the api container.
FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
# Which Caddyfile to bake: the default self-TLS variant (standalone Compose,
# where Caddy owns 80/443 and ACME), or deploy/Caddyfile.behind-proxy for hosts
# where an edge proxy (Coolify's Traefik) terminates TLS and forwards plain HTTP.
ARG CADDYFILE=deploy/Caddyfile
COPY ${CADDYFILE} /etc/caddy/Caddyfile
COPY --from=frontend /build/dist /srv
