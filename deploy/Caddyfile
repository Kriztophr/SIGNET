{$DOMAIN:localhost} {
	encode gzip

	request_body {
		max_size 10MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /auth/* /users/* /health /workflow/* /governance/* /evals/* /environment/* /resilience/* /docs* /openapi.json
	reverse_proxy @api api:8000

	# Everything else is the operations console (SPA with client-side routing).
	root * /srv
	try_files {path} /index.html
	file_server
}
