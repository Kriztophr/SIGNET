# Variant for hosts where an existing edge proxy (e.g. Coolify's Traefik)
# terminates TLS and forwards plain HTTP to this container. Caddy still owns
# static serving, API routing, the body cap, and defense-in-depth headers.
:80 {
	encode gzip

	request_body {
		max_size 10MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# handle blocks are mutually exclusive, so the SPA's try_files rewrite
	# can never swallow an API path.
	@api path /auth/* /users/* /health /workflow/* /governance/* /evals/* /environment/* /resilience/* /docs* /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
